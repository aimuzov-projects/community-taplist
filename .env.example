# Переменные сайта и API. На сервере лежат в /srv/community-taplist/.env, в git не попадают.
# Файл нужен даже пустым: compose передаёт его в Dockerfile сайта секретом.

# Токен GitHub только с правом на gist (fine-grained: Gists -- read and write).
# Локально можно не задавать: API отдаст пример таплиста из src/shared/mock.ts.
GITHUB_API_TOKEN=
# ID gist с таплистом -- хэш в конце его адреса.
GITHUB_GIST_ID=
# Файл внутри gist, например taplist.json.
GITHUB_GIST_FILENAME=

# 1 -- прочитать gist один раз и держать в памяти, редактор обновляет его при сохранении.
# Иначе gist читается на каждый запрос.
CACHE=1

# Как часто табло забирает свежий список, в миллисекундах. По умолчанию 60000.
# Это переменная сборки: после изменения сайт нужно пересобрать.
PUBLIC_DATA_UPDATE_INTERVAL=60000
