{
	"name": "community-taplist",
	"type": "module",
	"version": "2.1.0",
	"private": true,
	"description": "Электронный таплист крафтового бара: табло на телевизорах и веб-редактор, данные в GitHub Gist",
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"api": "node --watch --env-file-if-exists=.env src/backend/server.ts",
		"release": "release-it"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/svelte": "9.0.1",
		"@csstools/postcss-global-data": "4.0.0",
		"@fontsource/arsenal": "5.3.0",
		"@fontsource/blinker": "5.3.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@lucide/svelte": "1.39.0",
		"@release-it/conventional-changelog": "11.0.1",
		"@types/node": "26.6.5",
		"astro": "7.3.7",
		"conventional-commits-filter": "5.0.0",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-html": "2.0.0",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"release-it": "20.2.0",
		"stylelint": "17.16.0",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*"
	}
}
