---
import '@fontsource/arsenal/400.css'
import '@fontsource/arsenal/700.css'
import '@fontsource/blinker/700.css'
import '@aimuzov-projects/infra-site-kit/base.css'
import '#frontend/styles/global.css'

type Props = {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<!-- Блокирующий намеренно: полифиллы должны отработать до бандла Svelte. -->
		<script is:inline src="/polyfills.js"></script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
