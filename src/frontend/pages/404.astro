---
import Base from '#frontend/layouts/base.astro'
import '#frontend/styles/tv.css'
---

<Base title="Нет такой страницы">
	<main class="missing">
		<h1 class="missing__title">Нет такой страницы</h1>
		<a class="missing__link" href="/">
			К выбору экрана
		</a>
	</main>
</Base>

<style>
	.missing {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 1920rem;
		height: 1080rem;
		color: #d1d1d1;

		&__title {
			font-size: 96rem;
		}

		&__link {
			font-size: 56rem;
			color: #7e7c7c;
		}
	}
</style>
