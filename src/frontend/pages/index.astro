---
import Base from '#frontend/layouts/base.astro'
import { TV_COUNT } from '#shared/constants.ts'
import '#frontend/styles/tv.css'

const screens = Array.from({ length: TV_COUNT }, (_, index) => index + 1)
---

<Base title="Таплист">
	<div class="screen-picker">
		{screens.map((screen) => (
			<a class="screen-picker__screen" href={`/tv/${screen}`}>
				<span class="screen-picker__number">{screen}</span>
				<span class="screen-picker__label">Экран {screen}</span>
			</a>
		))}
		<a class="screen-picker__screen" href="/editor">
			<!--
				Карандаш из Lucide вставлен инлайном, так как astro check не умеет
				типизировать Svelte-компоненты внутри .astro.
			-->
			<svg
				class="screen-picker__icon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
				<path d="m15 5 4 4"></path>
			</svg>
			<span class="screen-picker__label">Редактор</span>
		</a>
	</div>
</Base>

<style>
	.screen-picker {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1920rem;
		height: 1080rem;
		background-color: #131111;

		&__screen {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			width: 520rem;
			height: 520rem;
			/* Flex gap появился в Chromium 84, отступы работают везде. */
			margin: 0 40rem;
			border: 8rem solid transparent;
			border-radius: 24rem;
			color: #7e7c7c;
			text-decoration: none;
			background-color: #1e1919;
			transition:
				transform 0.15s ease-out,
				border-color 0.15s ease-out;

			&:hover {
				transform: scale(1.05);
				border-color: #d1d1d1;
				color: #d1d1d1;
			}
		}

		&__number {
			font-family: Blinker, sans-serif;
			font-size: 320rem;
			font-weight: 700;
			line-height: 1;
		}

		&__icon {
			width: 320rem;
			height: 320rem;
		}

		&__label {
			font-size: 56rem;
		}
	}
</style>
